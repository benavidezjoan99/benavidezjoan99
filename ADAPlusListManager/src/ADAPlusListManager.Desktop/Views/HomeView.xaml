<UserControl x:Class="ADAPlusListManager.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <TextBlock Text="Inicio" Style="{StaticResource PageTitle}" />
      <Button Content="Actualizar" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,0,0,16" />
      <WrapPanel>
        <Border Style="{StaticResource Card}" Width="260">
          <StackPanel>
            <TextBlock Text="Estado del Zebra" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="{Binding ZebraStatus}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Width="260">
          <StackPanel>
            <TextBlock Text="Última conexión" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="{Binding LastConnection}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Width="320">
          <StackPanel>
            <TextBlock Text="Última importación" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="{Binding LastImport}" FontSize="14" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Width="200">
          <StackPanel>
            <TextBlock Text="Listados / Artículos" Foreground="{StaticResource MutedBrush}" />
            <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0">
              <Run Text="{Binding ListCount}" />
              <Run Text=" / " />
              <Run Text="{Binding ItemCount}" />
            </TextBlock>
          </StackPanel>
        </Border>
      </WrapPanel>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Servidor ADA+" FontWeight="SemiBold" />
          <TextBlock Text="{Binding AdaServerStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
