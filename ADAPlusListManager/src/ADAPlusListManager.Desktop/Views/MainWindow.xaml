<Window x:Class="ADAPlusListManager.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ADAPlusListManager.Desktop.ViewModels"
        xmlns:views="clr-namespace:ADAPlusListManager.Desktop.Views"
        Title="ADA+ List Manager"
        Height="720" Width="1180"
        MinHeight="600" MinWidth="960"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
      <views:DevicesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ImportViewModel}">
      <views:ImportView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ListsViewModel}">
      <views:ListsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
      <views:HistoryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
      <views:ReportsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
      <views:DiagnosticsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="ADA+ List Manager" Foreground="White" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="  ·  recuperación de listados Zebra" Foreground="#B3FFFFFF" VerticalAlignment="Center" Margin="8,0,0,0" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#E6FFFFFF" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Left" Width="220" Background="{StaticResource PrimaryBrush}">
      <StackPanel Margin="0,12,0,0">
        <Button Content="Inicio" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Home" />
        <Button Content="Dispositivos" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Devices" />
        <Button Content="Obtener listados" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Import" />
        <Button Content="Listados" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Lists" />
        <Button Content="Historial" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="History" />
        <Button Content="Reportes" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Reports" />
        <Button Content="Diagnóstico" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics" />
        <Button Content="Configuración" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
      </StackPanel>
    </Border>

    <Border Padding="20" Background="{StaticResource BgBrush}">
      <ContentControl Content="{Binding CurrentPage}" />
    </Border>
  </DockPanel>
</Window>
