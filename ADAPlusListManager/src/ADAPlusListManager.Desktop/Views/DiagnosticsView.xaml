<UserControl x:Class="ADAPlusListManager.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Diagnóstico" Style="{StaticResource PageTitle}" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Button Content="Capturar" Style="{StaticResource PrimaryButton}" Command="{Binding CaptureCommand}" />
        <Button Content="Exportar sanitizado" Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding Summary}" Margin="0,0,0,8" />
    </StackPanel>
    <ListBox ItemsSource="{Binding Lines}" />
  </DockPanel>
</UserControl>
