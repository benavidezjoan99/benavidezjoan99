<UserControl x:Class="ADAPlusListManager.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="Historial" Style="{StaticResource PageTitle}" Margin="0,0,16,0" VerticalAlignment="Center" />
      <Button Content="Recargar" Style="{StaticResource PrimaryButton}" Command="{Binding ReloadCommand}" />
    </StackPanel>
    <DataGrid ItemsSource="{Binding Sessions}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Fecha" Binding="{Binding StartedAt}" Width="160" />
        <DataGridTextColumn Header="Archivo" Binding="{Binding FileName}" Width="*" />
        <DataGridTextColumn Header="Fuente" Binding="{Binding Source}" Width="100" />
        <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="120" />
        <DataGridTextColumn Header="Registros" Binding="{Binding RecordCount}" Width="90" />
        <DataGridCheckBoxColumn Header="DEMO" Binding="{Binding IsDemo}" Width="70" />
        <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="2*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
