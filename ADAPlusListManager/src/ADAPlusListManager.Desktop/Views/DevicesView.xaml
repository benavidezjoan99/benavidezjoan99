<UserControl x:Class="ADAPlusListManager.Desktop.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Dispositivos" Style="{StaticResource PageTitle}" />
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
        <Button Content="Detectar Zebra" Style="{StaticResource PrimaryButton}" Command="{Binding DetectCommand}" />
        <Button Content="Explorar almacenamiento" Style="{StaticResource PrimaryButton}" Command="{Binding ExploreCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,0,0,12" />
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <DataGrid ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutoGenerateColumns="False"
                IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nombre" Binding="{Binding FriendlyName}" Width="*" />
          <DataGridTextColumn Header="Fabricante" Binding="{Binding Manufacturer}" Width="*" />
          <DataGridTextColumn Header="Modelo" Binding="{Binding Model}" Width="*" />
          <DataGridCheckBoxColumn Header="EC50?" Binding="{Binding IsLikelyZebraEc50}" Width="70" />
          <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="100" />
        </DataGrid.Columns>
      </DataGrid>
      <DataGrid Grid.Column="1" ItemsSource="{Binding ExploredObjects}" AutoGenerateColumns="False"
                IsReadOnly="True" Margin="12,0,0,0" HeadersVisibility="Column">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*" />
          <DataGridCheckBoxColumn Header="Carpeta" Binding="{Binding IsFolder}" Width="70" />
          <DataGridTextColumn Header="Tamaño" Binding="{Binding SizeBytes}" Width="90" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</UserControl>
