# ObraCalc PR — variables de entorno
# Copia a .env.local. Sin estas vars la app usa SQLite local (Fase 1a).

# --- Fase 1b / 2: Supabase Auth + Postgres (opcional) ---
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # solo servidor; nunca en el browser

# Feature flag opcional (reservado)
# OBRACALC_PERSISTENCE=sqlite
